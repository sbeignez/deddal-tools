  {
    "id": "07fa6bc8-47bb-4937-825d-60d64257a67c",
    "code": "3X3-CFOP-F2L-03-FL",
    "case_set_id": "d983f542-c510-4272-81ce-8a7af2e1638a",
    "title": "F2L 3",
    "long_name": "F2L 3 FL",
