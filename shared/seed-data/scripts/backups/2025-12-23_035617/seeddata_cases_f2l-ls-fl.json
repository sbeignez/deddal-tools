  {
    "id": "f13ec332-6e42-418d-bfd2-5337773252bf",
    "code": "3X3-CFOP-F2L-02-FL",
    "case_set_id": "d983f542-c510-4272-81ce-8a7af2e1638a",
    "title": "F2L 2",
    "long_name": "F2L 2 FL",
    "kind": "f2l",
