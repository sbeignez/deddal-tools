# fastlane/Fastfile
# Main automation configuration
# Documentation: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do


  ###########################################################################
  # 1 - SNAP IT
  ###########################################################################

  # ALIAS
  # -------------------------------------------------------------------------

  desc "Alias for screenshots_prod"
  lane :snap do
    screenshots_prod
  end

  # SCREENSHOTS PROD
  # -------------------------------------------------------------------------

  desc "Generate all production screenshots - all devices, all languages"
  desc "Usage: fastlane screenshots_prod"
  lane :screenshots_prod do
    puts "✅ START: screenshots_prod"

    # iOS version will be detected automatically from running simulators

    # Archive old production screenshots if they exist
    if File.directory?("./tool-fastlane/screenshots")
      archive_screenshots(
        source: "./tool-fastlane/screenshots",
        archive_base: "./tool-fastlane/screenshots_archives",
        prefix: "prod"
      )
    end

    # Uses configuration from Snapfile
    snapshot
    puts "✅ END: screenshots_prod"
  end

  # SCREENSHOTS TEST
  # -------------------------------------------------------------------------

  desc "Quick screenshot test - 1 device, 1 language (English)"
  desc "Usage: fastlane screenshots_test"
  lane :screenshots_test do
    puts "✅ END: screenshots_test"
    # iOS version will be detected automatically from running simulators

    # Archive old test screenshots if they exist
    if File.directory?("./tool-fastlane/screenshots_test")
      archive_screenshots(
        source: "./tool-fastlane/screenshots_test",
        archive_base: "./tool-fastlane/screenshots_archives",
        prefix: "test"
      )
    end

    snapshot(
      devices: ["iPhone 15 Pro Max"],
      languages: ["en-US"],
      # output_directory: "./tool-fastlane/screenshots_test",
      clear_previous_screenshots: false,  # We already archived, no need to clear
    )
    puts "✅ END: screenshots_test"
  end


  ###########################################################################
  # 2- FRAME IT
  ###########################################################################


  desc "Add device frames to production screenshots"
  lane :frame do
    frameit(
      path: "./tool-fastlane/screenshots",
      silver: true
    )
  end

  desc "Test framing on existing test screenshots"
  lane :frame_test do
    frameit(
      force_device_type: "iPhone 14 Pro",
      path: "./tool-fastlane/screenshots_test"
    )
  end

  ###########################################################################
  # 2.5 - DARK MODE SCREENSHOTS
  ###########################################################################

  desc "Generate dark mode screenshots - all devices, all languages"
  desc "Usage: fastlane screenshots_dark"
  lane :screenshots_dark do
    puts "✅ START: screenshots_dark"

    # Archive old dark mode screenshots if they exist
    if File.directory?("./tool-fastlane/screenshots_dark")
      archive_screenshots(
        source: "./tool-fastlane/screenshots_dark",
        archive_base: "./tool-fastlane/screenshots_archives",
        prefix: "dark"
      )
    end

    # Generate dark mode screenshots with appearance override
    snapshot(
      output_directory: "./tool-fastlane/screenshots_dark",
      clear_previous_screenshots: false,  # We already archived
      dark_mode: true  # Enable dark mode in simulator
    )

    puts "✅ END: screenshots_dark"
  end

  desc "Generate both light and dark mode screenshots"
  desc "Usage: fastlane screenshots_both"
  lane :screenshots_both do
    puts "✅ START: screenshots_both"

    # Generate light mode (standard)
    screenshots_prod

    # Generate dark mode
    screenshots_dark

    puts "✅ END: screenshots_both - Screenshots available in:"
    puts "  Light: ./fastlane/screenshots"
    puts "  Dark:  ./fastlane/screenshots_dark"
  end

  desc "Quick dark mode test - 1 device, 1 language"
  desc "Usage: fastlane screenshots_dark_test"
  lane :screenshots_dark_test do
    puts "✅ START: screenshots_dark_test"

    # Archive old test screenshots if they exist
    if File.directory?("./tool-fastlane/screenshots_dark_test")
      archive_screenshots(
        source: "./tool-fastlane/screenshots_dark_test",
        archive_base: "./tool-fastlane/screenshots_archives",
        prefix: "dark_test"
      )
    end

    snapshot(
      devices: ["iPhone 15 Pro Max"],
      languages: ["en-US"],
      output_directory: "./tool-fastlane/screenshots_dark_test",
      clear_previous_screenshots: false,
      dark_mode: true
    )

    puts "✅ END: screenshots_dark_test"
  end

  ###########################################################################
  # 3- UPLOAD IT
  ###########################################################################


  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )
    deliver(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: false
    )
  end

  desc "Test upload - Upload screenshots from screenshots_test directory"
  lane :test_upload do
    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )
    deliver(
      api_key: api_key,
      screenshots_path: "./screenshots_test",
      skip_metadata: true,
      skip_screenshots: false,
      skip_binary_upload: true
    )
  end



  desc "Complete screenshot workflow: generate + frame"
  lane :screenshots_complete do
    screenshots_prod
    add_frames
    puts "✅ All screenshots generated and framed!"
  end



  ###########################################################################
  # UPLOAD LANES (App Store Connect)
  ###########################################################################



  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )
    deliver(
      api_key: api_key,
      skip_metadata: false,
      skip_screenshots: true
    )
  end

  desc "Upload only release notes to App Store Connect (no screenshots/binary)"
  lane :upload_release_notes do
    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )

    deliver(
      api_key: api_key,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: false
    )
  end

  desc "Upload both screenshots and metadata to App Store Connect"
  lane :upload_all do
    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )
    deliver(
      api_key: api_key,
      skip_metadata: false,
      skip_screenshots: false
    )
  end

  desc "Update all release notes with standard minimal text"
  desc "Usage: bundle exec fastlane ios update_release_notes"
  lane :update_release_notes do
    puts "📝 Updating release notes for all locales..."
    sh("python3", "../tool-fastlane/metadata/align_release_notes_minimal.py")
    puts "✅ Release notes updated! Use 'upload_metadata' to upload to App Store Connect."
  end

  ###########################################################################
  # VERSION MANAGEMENT LANES
  ###########################################################################

  # --- Local Version Display & Modification ---

  desc "Show current version and build numbers from Xcode project"
  desc "Usage: bundle exec fastlane ios show_version"
  lane :show_version do
    version = get_version_number(
      xcodeproj: "./Deddal.xcodeproj",
      target: "Deddal"
    )
    build = get_build_number(
      xcodeproj: "./Deddal.xcodeproj"
    )

    puts "\n📱 Current Version"
    puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    puts "   Version: #{version}"
    puts "   Build: #{build}"
    puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
  end

  desc "Increment patch version (1.2.3 → 1.2.4)"
  desc "Usage: bundle exec fastlane ios bump_patch"
  lane :bump_patch do
    old_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")

    increment_version_number(
      xcodeproj: "./Deddal.xcodeproj",
      bump_type: "patch"
    )

    new_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    puts "✅ Version bumped: #{old_version} → #{new_version}"
  end

  desc "Increment minor version (1.2.3 → 1.3.0)"
  desc "Usage: bundle exec fastlane ios bump_minor"
  lane :bump_minor do
    old_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")

    increment_version_number(
      xcodeproj: "./Deddal.xcodeproj",
      bump_type: "minor"
    )

    new_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    puts "✅ Version bumped: #{old_version} → #{new_version}"
  end

  desc "Increment major version (1.2.3 → 2.0.0)"
  desc "Usage: bundle exec fastlane ios bump_major"
  lane :bump_major do
    old_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")

    increment_version_number(
      xcodeproj: "./Deddal.xcodeproj",
      bump_type: "major"
    )

    new_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    puts "✅ Version bumped: #{old_version} → #{new_version}"
  end

  desc "Set specific version number"
  desc "Usage: bundle exec fastlane ios set_version version:1.2.3"
  lane :set_version do |options|
    version = options[:version]

    if version.nil? || version.empty?
      UI.user_error!("❌ Please specify version: bundle exec fastlane ios set_version version:1.2.3")
      next
    end

    old_version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")

    increment_version_number(
      xcodeproj: "./Deddal.xcodeproj",
      version_number: version
    )

    puts "✅ Version changed: #{old_version} → #{version}"
  end

  desc "Increment build number"
  desc "Usage: bundle exec fastlane ios bump_build"
  lane :bump_build do
    old_build = get_build_number(xcodeproj: "./Deddal.xcodeproj")

    increment_build_number(
      xcodeproj: "./Deddal.xcodeproj"
    )

    new_build = get_build_number(xcodeproj: "./Deddal.xcodeproj")
    puts "✅ Build number bumped: #{old_build} → #{new_build}"
  end

  desc "Commit version changes to git"
  desc "Usage: bundle exec fastlane ios commit_version"
  lane :commit_version do
    version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    build = get_build_number(xcodeproj: "./Deddal.xcodeproj")

    git_commit(
      path: ["./Deddal.xcodeproj/project.pbxproj"],
      message: "Bump version to #{version} (#{build})\n\nGenerated by Trophee Ltd"
    )

    puts "✅ Version changes committed: #{version} (#{build})"
  end

  desc "Create git tag for current version"
  desc "Usage: bundle exec fastlane ios tag_version"
  lane :tag_version do
    version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    build = get_build_number(xcodeproj: "./Deddal.xcodeproj")
    tag = "v#{version}-#{build}"

    add_git_tag(
      tag: tag,
      message: "Version #{version} (Build #{build})"
    )

    push_git_tags

    puts "✅ Git tag created and pushed: #{tag}"
  end

  # --- Combined Release Workflows ---

  desc "Patch release workflow: bump patch → increment build → commit → tag → create ASC version"
  desc "Usage: bundle exec fastlane ios release_patch"
  lane :release_patch do
    puts "🚀 Starting patch release workflow..."

    bump_patch
    bump_build
    commit_version
    tag_version

    version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    create_new_version(version: version)

    puts "✅ Patch release complete! Version: #{version}"
    puts "📝 Next: Upload build to TestFlight for this version"
  end

  desc "Minor release workflow: bump minor → reset build to 1 → commit → tag → create ASC version"
  desc "Usage: bundle exec fastlane ios release_minor"
  lane :release_minor do
    puts "🚀 Starting minor release workflow..."

    bump_minor
    increment_build_number(xcodeproj: "./Deddal.xcodeproj", build_number: "1")
    commit_version
    tag_version

    version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    create_new_version(version: version)

    puts "✅ Minor release complete! Version: #{version}"
    puts "📝 Next: Upload build to TestFlight for this version"
  end

  desc "Major release workflow: bump major → reset build to 1 → commit → tag → create ASC version"
  desc "Usage: bundle exec fastlane ios release_major"
  lane :release_major do
    puts "🚀 Starting major release workflow..."

    bump_major
    increment_build_number(xcodeproj: "./Deddal.xcodeproj", build_number: "1")
    commit_version
    tag_version

    version = get_version_number(xcodeproj: "./Deddal.xcodeproj", target: "Deddal")
    create_new_version(version: version)

    puts "✅ Major release complete! Version: #{version}"
    puts "📝 Next: Upload build to TestFlight for this version"
  end

  desc "Custom version release workflow: set version → set build → commit → tag → create ASC version"
  desc "Usage: bundle exec fastlane ios release_custom version:1.2.3 build:42"
  lane :release_custom do |options|
    version = options[:version]
    build = options[:build] || "1"

    if version.nil? || version.empty?
      UI.user_error!("❌ Please specify version: bundle exec fastlane ios release_custom version:1.2.3 build:1")
      next
    end

    puts "🚀 Starting custom release workflow..."

    set_version(version: version)
    increment_build_number(xcodeproj: "./Deddal.xcodeproj", build_number: build)
    commit_version
    tag_version
    create_new_version(version: version)

    puts "✅ Custom release complete! Version: #{version} (Build #{build})"
    puts "📝 Next: Upload build to TestFlight for this version"
  end

  # --- App Store Connect Version Management ---

  desc "Check current App Store Connect version status"
  desc "Usage: bundle exec fastlane ios check_version_status"
  lane :check_version_status do
    puts "🔍 Checking App Store Connect version status..."

    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )

    require 'spaceship'

    # Get the app using Spaceship API
    begin
      app = Spaceship::ConnectAPI::App.find("hk.com.trophee.lookahead")

      puts "\n📱 App: Deddal"
      puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

      if app
        # Get live version
        live_version = app.get_live_app_store_version
        if live_version
          puts "\n🟢 LIVE VERSION:"
          puts "   Version: #{live_version.version_string}"
          puts "   Status: Live on App Store"
        else
          puts "\n⚪ No live version found"
        end

        # Get edit version (in development)
        edit_version = app.get_edit_app_store_version
        if edit_version
          puts "\n🟡 EDIT VERSION (in development):"
          puts "   Version: #{edit_version.version_string}"
          if edit_version.app_store_state
            status = edit_version.app_store_state
            status_emoji = case status
            when "PREPARE_FOR_SUBMISSION" then "📝"
            when "WAITING_FOR_REVIEW" then "⏳"
            when "IN_REVIEW" then "👀"
            when "PENDING_DEVELOPER_RELEASE" then "✅"
            when "READY_FOR_SALE" then "🟢"
            when "REJECTED" then "❌"
            when "METADATA_REJECTED" then "⚠️"
            when "PENDING_APPLE_RELEASE" then "⏰"
            when "DEVELOPER_REJECTED" then "🚫"
            else "❓"
            end
            puts "   Status: #{status_emoji} #{status.split('_').map(&:capitalize).join(' ')}"
          end
        else
          puts "\n⚪ No version in development"
        end
      end

      puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"

    rescue => exception
      UI.error("❌ Failed to fetch version info: #{exception.message}")
      UI.message("💡 Make sure you have at least one version in App Store Connect")
    end
  end

  desc "Create a new App Store Connect version"
  desc "Usage: bundle exec fastlane ios create_new_version version:1.0.7"
  lane :create_new_version do |options|
    version = options[:version]

    if version.nil? || version.empty?
      UI.user_error!("❌ Please specify a version number: bundle exec fastlane ios create_new_version version:1.0.7")
      next
    end

    puts "🎯 Creating new version: #{version}"

    api_key = app_store_connect_api_key(
      key_id: "927VU8P24W",
      issuer_id: "725a1df3-e6a3-4a3a-ae81-12b280dc89d7",
      key_filepath: "#{Dir.home}/fastlane-keys/AuthKey_927VU8P24W.p8"
    )

    # First check if version already exists
    begin
      app_info = app_store_version_info(
        api_key: api_key,
        app_identifier: "hk.com.trophee.lookahead"
      )

      edit_version = app_info[:edit_version]
      if edit_version && edit_version[:version_string] == version
        puts "\n⚠️  Version #{version} already exists in development!"
        puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        puts "   Status: #{edit_version[:app_store_state]}" if edit_version[:app_store_state]
        puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        puts "\n💡 Use check_version_status to see all versions"
        next
      end
    rescue => e
      UI.message("Note: Could not check existing versions: #{e.message}")
    end

    # Create new version using deliver
    begin
      puts "\n📦 Creating version #{version}..."

      deliver(
        api_key: api_key,
        app_version: version,
        skip_binary_upload: true,
        skip_screenshots: true,
        skip_metadata: true,
        force: true,
        run_precheck_before_submit: false
      )

      puts "\n✅ Successfully created version #{version}!"
      puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      puts "   Version: #{version}"
      puts "   Status: Prepare for Submission"
      puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      puts "\n📝 Next steps:"
      puts "   1. Upload a build for this version"
      puts "   2. Update metadata: bundle exec fastlane ios upload_metadata"
      puts "   3. Submit for review when ready"

    rescue => exception
      UI.error("❌ Failed to create version: #{exception.message}")
      if exception.message.include?("version already exists") || exception.message.include?("duplicate")
        UI.message("💡 The version may already exist. Use check_version_status to verify.")
      end
    end
  end

  ###########################################################################
  # UTILITY LANES
  ###########################################################################

  desc "Clean test screenshots"
  lane :clean_test do
    sh("rm", "-rf", "../tool-fastlane/screenshots_test")
    puts "✅ Test screenshots cleaned"
  end

  desc "Clean production screenshots"
  lane :clean_prod do
    sh("rm", "-rf", "../tool-fastlane/screenshots")
    puts "✅ Production screenshots cleaned"
  end


  ###########################################################################
  # HELPER FUNCTIONS
  ###########################################################################

  # Archive screenshots to dated folder, keeping only latest per day
  private_lane :archive_screenshots do |options|
    source = options[:source]
    archive_base = options[:archive_base]
    prefix = options[:prefix] || ""

    # Get current date in YYYY-MM-DD format
    date = Time.now.strftime("%Y-%m-%d")
    timestamp = Time.now.strftime("%Y-%m-%d_%H-%M-%S")

    # Create archive directory structure
    archive_dir = "#{archive_base}/#{date}"
    FileUtils.mkdir_p(archive_dir)

    # Archive with timestamp
    archive_path = "#{archive_dir}/#{prefix}_#{timestamp}"

    puts "📦 Archiving screenshots to: #{archive_path}"
    FileUtils.cp_r(source, archive_path)

    # Clean up: keep only latest archive for today
    todays_archives = Dir.glob("#{archive_dir}/#{prefix}_*").sort
    if todays_archives.length > 1
      # Remove all but the latest (which we just created)
      todays_archives[0..-2].each do |old_archive|
        puts "🗑️  Removing old archive: #{old_archive}"
        FileUtils.rm_rf(old_archive)
      end
    end

    puts "✅ Archived! Keeping latest version for #{date}"
  end

  ###########################################################################
  # HOOKS
  ###########################################################################

  before_all do
    puts "🚀 Starting Fastlane..."
  end

  after_all do |lane|
    puts "✅ Successfully completed: #{lane}"
  end

  error do |lane, exception|
    puts "❌ Error in #{lane}: #{exception.message}"
  end

end
